# MongoDB (Atlas connection string)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devpulse

# MySQL (e.g. PlanetScale, Railway, or any hosted MySQL)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=devpulse
MYSQL_SSL=true

# GitHub activity widget
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=

# Set automatically by Vercel in production — leave blank locally
VERCEL_URL=
